{
  "name": "@cognia/browser-extension",
  "version": "0.1.1",
  "private": true,
  "description": "Cognia Browser Companion \u2014 a Chrome/Edge side panel that hands the page you are reading to the Cognia app running on this machine.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "node scripts/build-notices.mjs && wxt build",
    "zip": "node scripts/build-notices.mjs && wxt zip",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "postinstall": "wxt prepare",
    "test": "jest --runInBand",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:e2e": "pnpm zip && pnpm archive:check && playwright test && pnpm archive:check",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "standalone:check": "node scripts/check-standalone.mjs && pnpm test:scripts",
    "check": "pnpm standalone:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "archive:check": "node scripts/check-archive.mjs"
  },
  "dependencies": {
    "@cognia/companion-client": "file:vendor/companion-client",
    "@cognia/plugin-ui": "file:vendor/plugin-ui",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "motion": "13.4.4",
    "react-hook-form": "^7.89.0",
    "sonner": "^2.0.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "wxt": "^0.21.4",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.9",
    "tw-animate-css": "^1.4.0",
    "@swc/jest": "0.2.39",
    "@swc/core": "^1.15.0",
    "typescript-eslint": "8.72.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@testing-library/dom": "^10.4.2"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/cognia-labs/cognia-browser-extension.git"
  },
  "bugs": {
    "url": "https://github.com/cognia-labs/cognia-browser-extension/issues"
  },
  "homepage": "https://github.com/cognia-labs/cognia-browser-extension#readme",
  "packageManager": "pnpm@11.25.0"
}
